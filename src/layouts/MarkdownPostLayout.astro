---
import BackToTop from '../components/BackToTop.astro';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import '../styles/MarkdownPost-Prince.css';

const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
    <p>Published on: {frontmatter.pubDate.toString().slice(0,10)}</p>
    <p><em>{frontmatter.description}</em></p>
    <p>Written by {frontmatter.author}</p>
    <div class="tags">
        {frontmatter.tags.map((tag: string) => (
        <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
        ))}
    </div>
    <div class="markdown-prince">
      <slot />
    </div>
    <div class="back-to-top-container">
      <BackToTop />
    </div>
    <Comments title={frontmatter.title} />
</BaseLayout>

<style>
  .back-to-top-container {
    /* 确保容器不影响页面布局 */
    position: relative;
    width: 100%;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: none;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #1A1B1F;
  }
  .tag a{color:#C1C3C7;}
</style>

<!-- 纯JS版MathJax配置（无TS语法，避免声明错误） -->
<script is:inline>
  // 直接赋值，用JS容错判断替代TS类型声明
  window.MathJax = window.MathJax || {};
  window.MathJax = {
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      packages: { '[+]': ['amsmath', 'amssymb'] }
    },
    chtml: {
      scale: 1,
      displayAlign: 'left',
      matchFontHeight: true
    },
    startup: {
      ready() {
        // 容错：确保defaultReady方法存在再调用
        if (typeof window.MathJax?.startup?.defaultReady === 'function') {
          window.MathJax.startup.defaultReady();
        }
        
        // 修复：先判断节点存在且父节点非空，再包裹容器
        const formulaContainers = document.querySelectorAll('mjx-container.mjx-chtml[display="true"]');
        formulaContainers.forEach(container => {
          // 双重判断，避免null报错
          if (container && container.parentNode) {
            const wrapper = document.createElement('div');
            wrapper.className = 'math-container';
            container.parentNode.insertBefore(wrapper, container);
            wrapper.appendChild(container);
          }
        });
      }
    }
  };
</script>

<!-- 引入MathJax核心库 -->
<script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>