---
import BaseLayout from "../../layouts/BaseLayout.astro";
const allPosts = Object.values(import.meta.glob('../posts/*.md', { eager: true }));
const tags = [...new Set(allPosts.map((post: any) => post.frontmatter.tags).flat())];

// 计算每个标签的文章数量
const tagCounts: Record<string, number> = {};
allPosts.forEach((post: any) => {
  post.frontmatter.tags?.forEach((tag: string) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

// 按文章数量排序（从多到少）
const sortedTags = [...tags].sort((a, b) => tagCounts[b] - tagCounts[a]);

const pageTitle = "森森的标签";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="tags-container">
    <!-- 粒子背景容器 -->
    <div class="particles-container" id="particles"></div>

    <!-- 页面头部 -->
    <div class="page-header">
      <h1 class="page-title">
        <span class="title-gradient">标签云</span>
      </h1>
      <p class="page-subtitle">探索所有博客标签，点击标签查看相关文章</p>
      <div class="title-underline"></div>
      <p class="page-description">标签大小反映了文章数量，越大表示相关文章越多</p>
    </div>

    <!-- 标签云 -->
    <div class="tags-cloud" id="tagsCloud">
      {sortedTags.map((tag) => {
        const count = tagCounts[tag];
        // 根据文章数量计算大小比例（1-2之间）
        const sizeRatio = 1 + (count / Math.max(...Object.values(tagCounts))) * 1;
        // 根据文章数量计算颜色深度
        const colorIntensity = 0.2 + (count / Math.max(...Object.values(tagCounts))) * 0.4;

        return (
          <a
            href={`/tags/${tag}`}
            class="tag-item"
            data-count={count}
            style={`
              --size-ratio: ${sizeRatio};
              --color-intensity: ${colorIntensity};
              --hue: ${tag.charCodeAt(0) % 360};
            `}
          >
            <span class="tag-text">{tag}</span>
            <span class="tag-count">{count}篇</span>
            <div class="tag-glow"></div>
          </a>
        );
      })}
    </div>

    <!-- 悬浮提示 -->
    <div class="hover-tip" id="hoverTip">
      点击标签查看相关文章
    </div>
  </div>

  <style>
    .tags-container {
      position: relative;
      min-height: 100vh;
      padding: 2rem 1rem;
      overflow: hidden;
      background: linear-gradient(
        135deg,
        rgba(102, 126, 234, 0.05) 0%,
        rgba(118, 75, 162, 0.05) 50%,
        rgba(240, 147, 251, 0.05) 100%
      );
    }

    /* 粒子背景 */
    .particles-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    /* 页面头部 */
    .page-header {
      text-align: center;
      margin-bottom: 4rem;
      position: relative;
      z-index: 2;
      opacity: 0;
      transform: translateY(30px);
      animation: fadeInUp 0.8s ease forwards;
    }

    .page-title {
      font-size: 3.5rem;
      font-weight: 800;
      margin: 0 0 1rem 0;
      line-height: 1.2;
    }

    .title-gradient {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      display: inline-block;
    }

    .title-gradient::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 4px;
      background: linear-gradient(90deg, #667eea, #764ba2, #f093fb);
      border-radius: 2px;
      animation: expandUnderline 1s ease 0.5s forwards;
    }

    @keyframes expandUnderline {
      to { width: 60%; }
    }

    .page-subtitle {
      font-size: 1.2rem;
      color: rgba(0, 0, 0, 0.7);
      margin: 1.5rem 0 0.5rem 0;
      font-weight: 400;
      letter-spacing: 0.5px;
    }

    .page-description {
      font-size: 0.95rem;
      color: rgba(0, 0, 0, 0.5);
      margin: 0.5rem 0 0 0;
      font-weight: 300;
    }

    .title-underline {
      width: 100px;
      height: 3px;
      background: linear-gradient(90deg, transparent, #667eea, transparent);
      margin: 2rem auto 0;
      opacity: 0;
      animation: fadeIn 1s ease 0.3s forwards;
    }

    /* 标签云 */
    .tags-cloud {
      position: relative;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }

    .tag-item {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1rem 1.5rem;
      text-decoration: none;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.95);
      border: 2px solid transparent;
      box-shadow:
        0 10px 30px rgba(102, 126, 234, 0.15),
        inset 0 0 20px rgba(255, 255, 255, 0.8);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      transform: scale(calc(var(--size-ratio) * 0.7));
      transform-style: preserve-3d;
      perspective: 1000px;
      cursor: pointer;
      backdrop-filter: blur(10px);
      overflow: hidden;
      min-width: 120px;
    }

    .tag-item::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(
        45deg,
        hsl(calc(var(--hue) + 0), 70%, 60%),
        hsl(calc(var(--hue) + 60), 70%, 60%),
        hsl(calc(var(--hue) + 120), 70%, 60%),
        hsl(calc(var(--hue) + 180), 70%, 60%),
        hsl(calc(var(--hue) + 240), 70%, 60%),
        hsl(calc(var(--hue) + 300), 70%, 60%)
      );
      border-radius: 22px;
      z-index: -1;
      opacity: var(--color-intensity);
      filter: blur(10px);
      transition: opacity 0.5s ease;
    }

    .tag-item:hover {
      transform: scale(calc(var(--size-ratio) * 0.8)) translateY(-10px) rotateX(10deg);
      box-shadow:
        0 25px 50px rgba(102, 126, 234, 0.3),
        0 0 60px rgba(102, 126, 234, 0.2),
        inset 0 0 30px rgba(255, 255, 255, 0.9);
      border-color: rgba(102, 126, 234, 0.5);
    }

    .tag-item:hover::before {
      opacity: calc(var(--color-intensity) + 0.3);
      animation: gradientRotate 3s linear infinite;
    }

    .tag-text {
      font-size: calc(0.9rem * var(--size-ratio));
      font-weight: 700;
      color: #1a202c;
      margin-bottom: 0.5rem;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      z-index: 2;
    }

    .tag-item:hover .tag-text {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      transform: scale(1.05);
    }

    .tag-count {
      font-size: calc(0.65rem * var(--size-ratio));
      color: rgba(0, 0, 0, 0.6);
      font-weight: 500;
      background: rgba(102, 126, 234, 0.1);
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      transition: all 0.3s ease;
      position: relative;
      z-index: 2;
    }

    .tag-item:hover .tag-count {
      background: rgba(102, 126, 234, 0.2);
      color: #667eea;
      transform: translateY(-2px);
    }

    .tag-glow {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border-radius: 20px;
      background: linear-gradient(
        45deg,
        transparent 30%,
        rgba(255, 255, 255, 0.6) 50%,
        transparent 70%
      );
      background-size: 200% 200%;
      opacity: 0;
      z-index: 1;
      transition: opacity 0.3s ease;
    }

    .tag-item:hover .tag-glow {
      opacity: 0.6;
      animation: glowMove 2s linear infinite;
    }

    /* 悬浮提示 */
    .hover-tip {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      padding: 0.8rem 1.5rem;
      border-radius: 25px;
      box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
      font-size: 0.9rem;
      color: #667eea;
      font-weight: 500;
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 100;
      border: 1px solid rgba(102, 126, 234, 0.2);
      pointer-events: none;
    }

    .hover-tip.show {
      opacity: 1;
      transform: translateX(-50%) translateY(-10px);
    }

    /* 动画 */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes gradientRotate {
      0% { background-position: 0% 50%; }
      100% { background-position: 100% 50%; }
    }

    @keyframes glowMove {
      0% { background-position: -100% -100%; }
      100% { background-position: 200% 200%; }
    }

    /* 响应式设计 */
    @media (max-width: 768px) {
      .page-title {
        font-size: 2.5rem;
      }

      .page-subtitle {
        font-size: 1rem;
      }

      .tags-cloud {
        gap: 1rem;
        padding: 1rem;
      }

      .tag-item {
        padding: 0.8rem 1.2rem;
        min-width: 100px;
      }

      .tag-text {
        font-size: calc(0.8rem * var(--size-ratio));
      }

      .tag-count {
        font-size: calc(0.6rem * var(--size-ratio));
      }
    }

    @media (min-width: 1400px) {
      .tags-cloud {
        max-width: 1400px;
      }
    }
  </style>

  <script>
    // 粒子系统
    class ParticleSystem {
      constructor(container) {
        this.container = container;
        this.particles = [];
        this.particleCount = 50;
        this.colors = ['#667eea', '#764ba2', '#f093fb', '#f5576c'];
        this.init();
      }

      init() {
        // 创建粒子
        for (let i = 0; i < this.particleCount; i++) {
          this.createParticle();
        }

        // 动画循环
        this.animate();

        // 窗口大小变化时重置粒子
        window.addEventListener('resize', () => this.handleResize());
      }

      createParticle() {
        const particle = document.createElement('div');
        particle.className = 'particle';

        // 随机属性
        const size = Math.random() * 20 + 5;
        const color = this.colors[Math.floor(Math.random() * this.colors.length)];
        const x = Math.random() * 100;
        const y = Math.random() * 100;
        const duration = Math.random() * 20 + 10;
        const delay = Math.random() * 5;

        particle.style.cssText = `
          position: absolute;
          width: ${size}px;
          height: ${size}px;
          background: ${color};
          border-radius: 50%;
          left: ${x}vw;
          top: ${y}vh;
          opacity: ${Math.random() * 0.3 + 0.1};
          filter: blur(${size / 2}px);
          animation: float ${duration}s linear ${delay}s infinite;
        `;

        this.container.appendChild(particle);
        this.particles.push({
          element: particle,
          x, y, size, color, duration, delay
        });
      }

      animate() {
        // 更新粒子位置
        this.particles.forEach(particle => {
          const { element } = particle;
          // 创建浮动动画
          if (!element.style.animation.includes('float')) {
            element.style.animation = `float ${particle.duration}s linear ${particle.delay}s infinite`;
          }
        });

        requestAnimationFrame(() => this.animate());
      }

      handleResize() {
        // 重置粒子位置
        this.particles.forEach(particle => {
          particle.x = Math.random() * 100;
          particle.y = Math.random() * 100;
          particle.element.style.left = `${particle.x}vw`;
          particle.element.style.top = `${particle.y}vh`;
        });
      }
    }

    // 标签交互效果
    class TagInteraction {
      constructor() {
        this.tags = document.querySelectorAll('.tag-item');
        this.hoverTip = document.getElementById('hoverTip');
        this.init();
      }

      init() {
        // 标签悬浮效果
        this.tags.forEach(tag => {
          // 鼠标进入
          tag.addEventListener('mouseenter', (e) => {
            this.handleMouseEnter(e);
          });

          // 鼠标离开
          tag.addEventListener('mouseleave', (e) => {
            this.handleMouseLeave(e);
          });

          // 点击效果
          tag.addEventListener('click', (e) => {
            this.handleClick(e);
          });

          // 添加随机浮动动画
          this.addFloatAnimation(tag);
        });

        // 初始显示提示
        setTimeout(() => {
          this.showTip('尝试将鼠标悬停在标签上查看效果');
        }, 1000);
      }

      handleMouseEnter(e) {
        const tag = e.currentTarget;
        const count = tag.getAttribute('data-count');

        // 显示悬浮提示
        this.showTip(`点击查看 ${tag.querySelector('.tag-text').textContent} 的 ${count} 篇文章`);

        // 添加涟漪效果
        this.createRipple(tag, e);
      }

      handleMouseLeave(e) {
        // 隐藏悬浮提示
        this.hideTip();
      }

      handleClick(e) {
        const tag = e.currentTarget;

        // 创建点击波纹效果
        this.createClickRipple(tag, e);

        // 添加点击动画
        tag.style.animation = 'none';
        setTimeout(() => {
          tag.style.animation = 'tagClick 0.6s ease';
        }, 10);

        // 短暂隐藏提示
        this.hideTip();
        setTimeout(() => {
          this.showTip('正在跳转...');
        }, 300);
      }

      showTip(text) {
        if (this.hoverTip) {
          this.hoverTip.textContent = text;
          this.hoverTip.classList.add('show');
        }
      }

      hideTip() {
        if (this.hoverTip) {
          this.hoverTip.classList.remove('show');
        }
      }

      createRipple(tag, e) {
        const rect = tag.getBoundingClientRect();
        const ripple = document.createElement('div');
        ripple.className = 'tag-ripple';

        const size = Math.max(rect.width, rect.height) * 2;
        const x = e.clientX - rect.left - size / 2;
        const y = e.clientY - rect.top - size / 2;

        ripple.style.cssText = `
          position: absolute;
          width: ${size}px;
          height: ${size}px;
          background: radial-gradient(circle, rgba(102, 126, 234, 0.3) 0%, transparent 70%);
          border-radius: 50%;
          left: ${x}px;
          top: ${y}px;
          pointer-events: none;
          z-index: 1;
          animation: rippleExpand 1s ease-out forwards;
        `;

        tag.appendChild(ripple);

        // 移除涟漪效果
        setTimeout(() => {
          if (ripple.parentNode === tag) {
            tag.removeChild(ripple);
          }
        }, 1000);
      }

      createClickRipple(tag, e) {
        const rect = tag.getBoundingClientRect();
        const ripple = document.createElement('div');
        ripple.className = 'tag-click-ripple';

        const size = Math.max(rect.width, rect.height) * 3;
        const x = e.clientX - rect.left - size / 2;
        const y = e.clientY - rect.top - size / 2;

        ripple.style.cssText = `
          position: absolute;
          width: ${size}px;
          height: ${size}px;
          background: radial-gradient(circle, rgba(102, 126, 234, 0.4) 0%, transparent 70%);
          border-radius: 50%;
          left: ${x}px;
          top: ${y}px;
          pointer-events: none;
          z-index: 1;
          animation: clickRipple 0.8s ease-out forwards;
        `;

        tag.appendChild(ripple);

        // 移除涟漪效果
        setTimeout(() => {
          if (ripple.parentNode === tag) {
            tag.removeChild(ripple);
          }
        }, 800);
      }

      addFloatAnimation(tag) {
        // 添加随机浮动动画
        const duration = Math.random() * 3 + 2;
        const delay = Math.random() * 2;
        tag.style.animation = `tagFloat ${duration}s ease-in-out ${delay}s infinite`;
      }
    }

    // 页面加载完成后初始化
    document.addEventListener('DOMContentLoaded', () => {
      // 初始化粒子系统
      const particlesContainer = document.getElementById('particles');
      if (particlesContainer) {
        new ParticleSystem(particlesContainer);
      }

      // 初始化标签交互
      new TagInteraction();

      // 添加动画样式
      const style = document.createElement('style');
      style.textContent = `
        @keyframes float {
          0%, 100% {
            transform: translate(0, 0) rotate(0deg);
          }
          25% {
            transform: translate(10px, -10px) rotate(90deg);
          }
          50% {
            transform: translate(0, -20px) rotate(180deg);
          }
          75% {
            transform: translate(-10px, -10px) rotate(270deg);
          }
        }

        @keyframes tagFloat {
          0%, 100% {
            transform: scale(calc(var(--size-ratio) * 0.7)) translateY(0);
          }
          50% {
            transform: scale(calc(var(--size-ratio) * 0.72)) translateY(-5px);
          }
        }

        @keyframes tagClick {
          0% {
            transform: scale(calc(var(--size-ratio) * 0.8));
          }
          50% {
            transform: scale(calc(var(--size-ratio) * 0.6));
          }
          100% {
            transform: scale(calc(var(--size-ratio) * 0.7));
          }
        }

        @keyframes rippleExpand {
          0% {
            transform: scale(0.1);
            opacity: 1;
          }
          100% {
            transform: scale(1);
            opacity: 0;
          }
        }

        @keyframes clickRipple {
          0% {
            transform: scale(0.1);
            opacity: 0.8;
          }
          100% {
            transform: scale(1);
            opacity: 0;
          }
        }
      `;
      document.head.appendChild(style);
    });
  </script>
</BaseLayout>