---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';
import HeadImage from '../../public/images/headimage.jpg'
import { Picture } from 'astro:assets';
const pageTitle = "森森的主页";
---
<BaseLayout pageTitle = {pageTitle}>
  <div class="img-info-container">
    <div class="img-wrapper">
      <Picture src={HeadImage} alt = '' width="200" height="200" />
    </div>

    <div class="info-wrapper">
      <h2>森森</h2>
      <p>a XJTUer</p>
      <p>爱说话 爱代码 爱世界</p>
      <p>我是燕赵儿女，要为河北争气！</p>
      <button
        onclick = "window.location.href = '/about'">
        这人好有意思...
      </button>
    </div>
  </div>

  <Greeting client:load messages={["新年快乐，万事如意！", "Happy New Year! May it be filled with joy and success.", "새해 복 많이 받으세요!", "새해 복 많이 받으십시오!", "Bonne année ! Que la nouvelle année vous apporte bonheur et santé."]} />

  <style>
    .img-info-container {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 20px;
      max-width: 800px;
      margin: 0 auto;
    }

    .img-wrapper img {
      object-fit: cover;
      border-radius: 8px;
    }

    .info-wrapper {
      flex: 1;
    }
    .info-wrapper h2 {
      margin: 0 0 10px 0;
      color: #B8C7FB;
    }
    .info-wrapper p {
      margin: 5px 0;
      color: #666;
    }
    .info-wrapper button {
      margin-top: 10px;
      padding: 8px 16px;
      background: #1A1B1F;
      color: white;
      border: 1px solid #4f4f4f;;
      border-radius: 4px;
      cursor: pointer;
    }
  </style>
</BaseLayout>