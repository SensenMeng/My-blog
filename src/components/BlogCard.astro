---
const { title, description, pubDate, image, tags, url } = Astro.props;

// 格式化日期
const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

// 根据标签选择图标
const getTagIcon = (tag: string) => {
  const icons: Record<string, string> = {
    '技术实践与分享': '💻',
    '成长与经历': '🌱',
    '技术': '⚡',
    '生活': '🎨',
    '学习': '📚',
    '项目': '🚀'
  };
  return icons[tag] || '📝';
};

// 根据标签选择颜色
const getTagColor = (tag: string) => {
  const colors: Record<string, string> = {
    '技术实践与分享': '#667eea',
    '成长与经历': '#48bb78',
    '技术': '#4299e1',
    '生活': '#ed8936',
    '学习': '#9f7aea',
    '项目': '#f56565'
  };
  return colors[tag] || '#a0aec0';
};
---

<article class="blog-card" data-url={url}>
  <div class="card-glow"></div>
  <div class="card-image">
    {image && image !== 'none' ? (
      <img src={image} alt={title} />
    ) : (
      <div class="placeholder-image" style={`background: linear-gradient(135deg, ${getTagColor(tags?.[0] || 'default')} 0%, ${getTagColor(tags?.[0] || 'default')}99 100%)`}>
        <span class="emoji-icon">{getTagIcon(tags?.[0] || 'default')}</span>
      </div>
    )}
  </div>

  <div class="card-content">
    <div class="card-tags">
      {tags && tags.slice(0, 2).map((tag: string) => (
        <span class="tag" style={`--tag-color: ${getTagColor(tag)}`}>{tag}</span>
      ))}
    </div>

    <h3 class="card-title">{title}</h3>

    <p class="card-description">{description || '暂无描述'}</p>

    <div class="card-meta">
      <time class="card-date">{formatDate(pubDate)}</time>
      <a href={url} class="read-more">阅读全文 →</a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(102, 126, 234, 0.2);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    backdrop-filter: blur(10px);
  }

  .blog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg,
      rgba(102, 126, 234, 0.1) 0%,
      rgba(118, 75, 162, 0.1) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
    pointer-events: none;
  }

  .blog-card:hover {
    transform: translateY(-8px);
    border-color: rgba(102, 126, 234, 0.5);
    box-shadow:
      0 20px 40px rgba(102, 126, 234, 0.2),
      0 0 40px rgba(102, 126, 234, 0.15);
  }

  .blog-card:hover::before {
    opacity: 1;
  }

  .card-glow {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(135deg, #667eea, #764ba2, #f093fb, #f5576c);
    border-radius: 18px;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
    filter: blur(8px);
  }

  .blog-card:hover .card-glow {
    opacity: 0.3;
    animation: glowPulse 2s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.5; }
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .card-image img {
    transform: scale(1.1);
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .placeholder-image {
    transform: scale(1.1);
  }

  .emoji-icon {
    font-size: 4rem;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
  }

  .card-content {
    padding: 1.5rem;
    position: relative;
    z-index: 2;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: rgba(var(--tag-color-rgb, 102, 126, 234), 0.2);
    border: 1px solid var(--tag-color);
    border-radius: 12px;
    color: var(--tag-color);
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .blog-card:hover .tag {
    background: rgba(var(--tag-color-rgb, 102, 126, 234), 0.3);
    transform: translateY(-2px);
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a202c;
    margin: 0.5rem 0;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .blog-card:hover .card-title {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .card-description {
    color: rgba(0, 0, 0, 0.7);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(102, 126, 234, 0.2);
  }

  .card-date {
    color: rgba(0, 0, 0, 0.5);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .read-more {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    position: relative;
  }

  .read-more::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #667eea, #764ba2);
    transition: width 0.3s ease;
  }

  .read-more:hover::after {
    width: 100%;
  }

  .read-more:hover {
    color: #764ba2;
    transform: translateX(4px);
  }
</style>

<script>
  // 为卡片添加点击事件
  document.querySelectorAll('.blog-card').forEach(card => {
    card.addEventListener('click', (e) => {
      const url = card.getAttribute('data-url');
      const target = e.target as HTMLElement;

      // 如果点击的是"阅读全文"链接，让其正常工作
      if (target.classList.contains('read-more') || target.closest('.read-more')) {
        return;
      }

      // 否则整个卡片可点击
      if (url) {
        window.location.href = url;
      }
    });
  });
</script>