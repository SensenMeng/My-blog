---
// BlogAIQA.astro - 最终版：默认=暗色，html.dark=亮色，切换实时生效
interface Props {
  placeholder?: string;
}
const { placeholder = '请输入关于博客的问题...' } = Astro.props;
---

<div class="blog-ai-qa">
  <h3 class="qa-title">💡 博客智能问答（已嵌入8r规则）</h3>
  <div class="qa-container">
    <textarea id="question-input" placeholder={placeholder} rows="3" class="qa-input"></textarea>
    <button id="send-btn" class="qa-btn">发送</button>
    <div id="loading" class="qa-loading" style="display: none;">
      <span class="loading-dot"></span>
      <span class="loading-text">正在为你检索答案...</span>
    </div>
    <div id="answer-container" class="qa-answer"></div>
  </div>
</div>

<a href="/about#8r-rule" class="8r-link">什么是8r规则？</a>

<style>
/* 全局通用样式 & 重置 */
.blog-ai-qa * { margin: 0; padding: 0; box-sizing: border-box; }
.blog-ai-qa {
  max-width: 800px;
  margin: 3rem auto;
  padding: 2rem;
  border-radius: 12px;
  font-family: sans-serif;
  transition: all 0.3s ease;
}
.qa-title {
  font-size: 1.3rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 600;
  letter-spacing: 0.5px;
}
.qa-title::after {
  content: '';
  flex: 1;
  height: 1px;
  opacity: 0.7;
  background: linear-gradient(90deg, #1A1B1F, transparent);
}
.qa-container { display: flex; flex-direction: column; gap: 1.2rem; }
.qa-input {
  padding: 1rem 1.2rem;
  border: 1px solid;
  border-radius: 10px;
  font-size: 1rem;
  resize: vertical;
  min-height: 100px;
  max-height: 300px;
  font-family: sans-serif;
  line-height: 1.5;
  outline: none;
  transition: all 0.3s ease;
}
.qa-btn {
  padding: 0.8rem 1.5rem;
  border: none;
  border-radius: 10px;
  font-size: 1.2rem;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
  letter-spacing: 0.5px;
  background: #1A1B1F;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}
.qa-btn:hover {
  background: #28292E;
  transform: translateY(-2px);
}
.qa-btn:active {
  transform: translateY(0);
  background: #1A1B1F;
}
.qa-btn:disabled {
  background: #757575;
  transform: none;
  box-shadow: none;
  cursor: not-allowed;
  opacity: 0.7;
}
.qa-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  padding: 1.5rem;
  font-size: 1rem;
  line-height: 1.5;
}
.loading-dot::before {
  content: '...';
  font-size: 1.2rem;
  letter-spacing: 2px;
  animation: dot-flash 1.5s infinite linear;
}
@keyframes dot-flash {
  0%, 100% { opacity: 0.2; }
  25% { opacity: 1; }
  50% { opacity: 0.2; }
  75% { opacity: 1; }
}
.loading-text { font-style: italic; }
.qa-answer {
  padding: 1.5rem 1.2rem;
  border: 1px solid;
  border-radius: 10px;
  min-height: 100px;
  white-space: pre-wrap;
  line-height: 1.5;
  font-size: 1rem;
  font-family: sans-serif;
  transition: all 0.3s ease;
}
.qa-answer > div:has(> ❌), .qa-answer > span:contains('❌') {
  color: #F44336 !important;
  text-align: center;
  padding: 1rem 0;
}

/* 👇👇👇 核心1：默认状态（无html.dark）= 暗色模式（你的基础样式）【优先级基础】 */
.blog-ai-qa {
  background: #13161C !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3) !important;
  border: 1px solid #222327 !important;
}
.qa-title { color: #C1C3C7 !important; }
.qa-input {
  background: #1A1B1F !important;
  color: #C1C3C7 !important;
  border-color: #222327 !important;
}
.qa-input::placeholder { color: #888888 !important; }
.qa-input:focus {
  border-color: #1A1B1F !important;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1) !important;
}
.qa-btn {
  color: #C1C3C7 !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
}
.qa-btn:hover { box-shadow: 0 4px 10px rgba(255, 255, 255, 0.2) !important; }
.qa-btn:active { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important; }
.qa-btn:disabled { background: #9E9E9E !important; }
.qa-loading { color: #9E9E9E !important; }
.qa-answer {
  background: #1A1B1F !important;
  color: #C1C3C7 !important;
  border-color: #222327 !important;
  box-shadow: inset 0 1px 3px rgba(255, 255, 255, 0.1) !important;
}

/* 👇👇👇 核心2：html.dark = 亮色模式（你的反转样式）【优先级更高】 */
html.dark .blog-ai-qa {
  background: #ffffff !important;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08) !important;
  border: 1px solid #E0E0E0 !important;
}
html.dark .qa-title { color: #000000 !important; }
html.dark .qa-input {
  background: #F5F5F5 !important;
  color: #000000 !important;
  border-color: #E0E0E0 !important;
}
html.dark .qa-input::placeholder { color: #B0B0B0 !important; }
html.dark .qa-input:focus {
  border-color: #1A1B1F !important;
  box-shadow: 0 0 0 3px rgba(26, 27, 31, 0.1) !important;
}
html.dark .qa-btn {
  color: #FFFFFF !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06) !important;
}
html.dark .qa-btn:hover { box-shadow: 0 4px 10px rgba(26, 27, 31, 0.2) !important; }
html.dark .qa-btn:active { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06) !important; }
html.dark .qa-loading { color: #757575 !important; }
html.dark .qa-answer {
  background: #F5F5F5 !important;
  color: #000000 !important;
  border-color: #E0E0E0 !important;
  box-shadow: inset 0 1px 3px rgba(26, 27, 31, 0.1) !important;
}

/* 响应式适配（和你的全局断点一致） */
@media screen and (max-width: 636px) {
  .blog-ai-qa {
    margin: 1.5rem auto;
    padding: 1.5rem 1rem;
  }
  .qa-title { font-size: 1.1rem; margin-bottom: 1.2rem; }
  .qa-input { padding: 0.8rem 1rem; font-size: 0.95rem; min-height: 80px; }
  .qa-btn { padding: 0.5rem 1rem; font-size: 1rem; }
  .qa-answer { padding: 1.2rem 1rem; font-size: 0.95rem; }
}
@media screen and (max-width: 480px) {
  .blog-ai-qa { margin: 1rem auto; padding: 1rem; }
}
</style>

<script>
const questionInput = document.getElementById('question-input') as HTMLTextAreaElement;
const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
const loading = document.getElementById('loading') as HTMLDivElement;
const answerContainer = document.getElementById('answer-container') as HTMLDivElement;

// 🔥 类型定义，解决隐式 any
interface EmbeddingItem {
  id: string;
  title: string;
  content: string;
  embedding: number[];
}

let embeddings: EmbeddingItem[] = [];

// 加载向量库
async function loadEmbeddings() {
  try {
    const res = await fetch('/embeddings.json');
    const data = await res.json();
    embeddings = data as EmbeddingItem[];
    console.log('✅ 向量库加载完成:', embeddings.length);
  } catch (e) {
    console.error('❌ 向量库加载失败', e);
  }
}

// 余弦相似度
function cosineSimilarity(a: number[], b: number[]): number {
  let dot = 0, na = 0, nb = 0;
  for (let i = 0; i < a.length; i++) {
    dot += a[i] * b[i];
    na += a[i] ** 2;
    nb += b[i] ** 2;
  }
  return dot / (Math.sqrt(na) * Math.sqrt(nb));
}

// 获取问题向量
async function getQueryEmbedding(text: string): Promise<number[]> {
  const res = await fetch('/.netlify/functions/embed', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ text }),
  });
  return res.json();
}

// 检索上下文
async function retrieveContext(question: string): Promise<string> {
  if (!embeddings.length) return '';
  const qEmb = await getQueryEmbedding(question);
  const scored = embeddings
    .map(item => ({ ...item, score: cosineSimilarity(qEmb, item.embedding) }))
    .sort((a, b) => b.score - a.score);
  // 去重，确保来自不同文章，最多取 6 段
const seenTitles = new Set();
const topResults = [];

for (const item of scored) {
  if (topResults.length >= 6) break;
  if (item.score < 0.25) continue;

  if (!seenTitles.has(item.title)) {
    seenTitles.add(item.title);
    topResults.push(item);
  }
}

return topResults.map(i => `【${i.title}】\n${i.content}`).join('\n\n');
}

// 发送问题
async function sendQuestion() {
  const question = questionInput.value.trim();
  if (!question) {
    answerContainer.innerHTML = `<div>❌ 请输入你的问题～</div>`;
    return;
  }

  sendBtn.disabled = true;
  loading.style.display = 'flex';
  answerContainer.innerHTML = '';
  answerContainer.style.opacity = '0';

  try {
    const context = await retrieveContext(question);
    console.log('上下文长度：', context.length);
    const response = await fetch('/.netlify/functions/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question, context }),
    });

    const data = await response.json();
    if (!response.ok) throw new Error(data.error || '请求失败');
    answerContainer.innerHTML = data.answer;
  } catch (err: any) {
    answerContainer.innerHTML = `❌ 出错了：${err.message}`;
  } finally {
    sendBtn.disabled = false;
    loading.style.display = 'none';
    answerContainer.style.opacity = '1';
  }
}

// 事件
sendBtn.addEventListener('click', sendQuestion);
questionInput.addEventListener('keydown', (e) => {
  if (e.ctrlKey && e.key === 'Enter') { sendQuestion(); e.preventDefault(); }
});

questionInput.addEventListener('focus', () => {
  if (answerContainer.innerHTML.includes('❌')) answerContainer.innerHTML = '';
});

loadEmbeddings();
answerContainer.style.opacity = '1';
</script>